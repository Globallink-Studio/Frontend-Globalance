# Copiá este archivo a .env y completá los valores.
# Las variables de Firebase salen de console.firebase.google.com (tu app web).
# VITE_API_URL es la URL del backend en Railway que te dan las chicas.
# No uses .env.local: Vite le da prioridad y puede pisar valores de .env.

# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# API del back
VITE_API_URL=

# Modo de autenticación: 'mock' (usa los mocks locales) | 'firebase' (Firebase + API).
# Si está vacío: en dev local usa mock, y en el build de producción (deploy) usa firebase.
VITE_AUTH_MODE=
